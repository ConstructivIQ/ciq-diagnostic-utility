# ── Jira ───────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@constructiviq.com
JIRA_API_TOKEN=your_jira_api_token_here

# ── Claude / Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Email (IMAP) ───────────────────────────────────────────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=support@constructiviq.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FOLDER=INBOX

# ── Application logs ────────────────────────────────────────────────────────────
# Comma-separated paths; supports glob patterns
LOG_PATHS=/var/log/constructiviq/app.log,/var/log/constructiviq/error.log

# ── API health / error endpoints ────────────────────────────────────────────────
API_BASE_URL=https://api.constructiviq.com
API_AUTH_TOKEN=your_api_token_here
